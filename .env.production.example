# Copy to .env (never commit the real one).
# Cloudflare credentials, used by `wrangler deploy` and as GitHub Actions secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Raw Caller keys, one per Caller. Give each to that Caller; never commit.
# Generate with: node scripts/gen-callers.mjs crms pos ims hrms ecom portal authentication file-storage notifications
CALLER_KEY_CRMS=

# Caller map, set on the Worker with: set -a; . ./.env; set +a; printf '%s' "$CALLERS" | npx wrangler secret put CALLERS
# JSON array of { "name": "...", "keyHash": "<sha256 hex of the Caller's key>" }
CALLERS='[{"name":"crms","keyHash":"<sha256 hex>"}]'
