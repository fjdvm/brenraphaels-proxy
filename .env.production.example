# Runtime configuration for the Node container. Copy to .env.production (never commit secrets).
PORT=8080
AUDIT_LOGS_URL=https://audit.buildwrite.me
FILE_STORAGE_URL=https://files.buildwrite.me
NOTIFICATIONS_URL=https://notifications.buildwrite.me

# Preserve the existing CALLERS JSON and all its hashes/mappings when moving from Workers.
# Optional Caller fields: app, systemCode, auditKey, auditScope.
# A Caller needs systemCode for /files and auditKey for /audit.
# Generate NEW Caller credentials only with: node scripts/gen-callers.mjs <caller names>
CALLERS=[{"name":"portal","keyHash":"<existing sha256 hex>","systemCode":"POS","auditKey":"<existing audit key>"}]
FILE_STORAGE_TOKEN=
NOTIFICATIONS_TOKEN=
NOTIFICATIONS_GATEWAY_SECRET=
LIVE_TICKET_SECRET=

# Optional: preserve these for the storefront Staff signal route.
CREOMS_URL=
CREOMS_SIGNAL_SECRET=
